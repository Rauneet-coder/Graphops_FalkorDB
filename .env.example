# Compose-network graph address. Host-native development must override to localhost.
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_GRAPH=graphops
FALKORDB_CONNECT_TIMEOUT_SECONDS=1
FALKORDB_SOCKET_TIMEOUT_SECONDS=2
FALKORDB_QUERY_TIMEOUT_MS=500
GRAPH_WORKERS=4
GRAPH_INIT_RETRY_SECONDS=1
ENVIRONMENT=production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Published host ports; all bindings are restricted to 127.0.0.1.
FALKORDB_PUBLISHED_PORT=6379
BACKEND_PUBLISHED_PORT=8000
FRONTEND_PUBLISHED_PORT=3000

# Reserved API configuration for Stage 6; no domain API calls exist yet.
# Public address is built into browser assets; internal URL is server-side only.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://backend:8000
